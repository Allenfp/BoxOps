{
  "compilerOptions": {
    "target": "ES2022",
    // DOM too: unit tests import browser modules, and e2e code runs in the page.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["cli", "scripts", "e2e", "src/**/*.test.ts", "src/globals.d.ts", "vite.config.ts", "playwright.config.ts"]
}
