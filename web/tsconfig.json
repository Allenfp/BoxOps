{
  // Two projects, so browser code can't use Node APIs by accident:
  // tsconfig.app.json is the app (src/, browser types only) and
  // tsconfig.node.json is everything that runs in Node (cli/, scripts/, e2e/,
  // unit tests, configs). `npm run typecheck` (tsc -b) checks both.
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }]
}
