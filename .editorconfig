# The repo's text conventions, for editors that read EditorConfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown can end a line with two spaces on purpose (a line break).
[*.md]
trim_trailing_whitespace = false
